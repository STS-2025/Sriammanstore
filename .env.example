# Firebase web configuration. Keep these values aligned with the authorized project.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_PROJECT_NUMBER=your_project_number

# Optional public browser keys.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Location picker map tiles and routing. Keep the tile URL replaceable; OSM's
# community tile service has a usage policy and no availability guarantee.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Set this to the base URL of your self-hosted OSRM server (for example, https://routing.example.com).
VITE_OSRM_BASE_URL=

# Server-only payment secret. Never prefix this with VITE_.
RAZORPAY_KEY_SECRET=your_server_only_razorpay_secret
